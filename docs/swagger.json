{
  "openapi": "3.0.3",
  "info": {
    "title": "Team WBS API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "로컬 백엔드. 프론트(Vite)는 server.proxy['/api'] → 이 서버로 전달하므로 브라우저 호출 경로는 /api 프리픽스가 붙는다"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token",
        "description": "httpOnly, SameSite=Lax (로컬은 secure=false). 쿠키명은 refresh_token"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "DUPLICATE_EMAIL",
                  "UNAUTHORIZED",
                  "FORBIDDEN",
                  "NOT_FOUND"
                ]
              },
              "message": { "type": "string" }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error"]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "email": { "type": "string", "format": "email", "maxLength": 100 },
          "name": { "type": "string", "maxLength": 50 },
          "role": { "type": "string", "enum": ["ADMIN", "USER"] }
        },
        "required": ["id", "email", "name", "role"]
      },
      "UserSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string", "maxLength": 50 },
          "status": { "type": "string", "enum": ["ACTIVE", "WITHDRAWN"] }
        },
        "required": ["id", "name", "status"]
      },
      "AuthResponse": {
        "type": "object",
        "description": "로그인·재발급 공통 응답. refresh_token은 바디가 아닌 httpOnly 쿠키로 전달된다",
        "properties": {
          "access_token": { "type": "string", "description": "유효기간 15분. Authorization: Bearer 헤더에 사용" },
          "user": { "$ref": "#/components/schemas/User" }
        },
        "required": ["access_token", "user"]
      },
      "TimeAllocation": {
        "type": "object",
        "properties": {
          "work_date": {
            "type": "string",
            "format": "date",
            "description": "해당 WBS의 start_date ~ end_date 범위 내여야 함(벗어나면 400 VALIDATION_ERROR). 한 WBS 내에서 중복될 수 없음"
          },
          "hours": { "type": "integer", "minimum": 1, "maximum": 8, "description": "1시간 단위. 건별 상한은 8이며, 회원의 일자 합계가 8을 넘는 것은 허용됨(경고만 표시)" }
        },
        "required": ["work_date", "hours"]
      },
      "Wbs": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "writer_id": { "type": "integer", "format": "int64", "description": "작성자. 삭제 버튼 노출 판단 기준" },
          "writer_name": { "type": "string", "maxLength": 50 },
          "writer_status": { "type": "string", "enum": ["ACTIVE", "WITHDRAWN"], "description": "WITHDRAWN이면 프론트가 이름 옆에 \"(탈퇴)\"를 합성해 표시" },
          "assignee_id": { "type": "integer", "format": "int64" },
          "assignee_name": { "type": "string", "maxLength": 50 },
          "assignee_status": { "type": "string", "enum": ["ACTIVE", "WITHDRAWN"], "description": "WITHDRAWN이면 프론트가 이름 옆에 \"(탈퇴)\"를 합성해 표시" },
          "title": { "type": "string", "maxLength": 200 },
          "content": { "type": "string", "nullable": true },
          "start_date": { "type": "string", "format": "date" },
          "end_date": { "type": "string", "format": "date", "description": "start_date 이상이어야 함(DB CHECK 제약)" },
          "status": {
            "type": "string",
            "enum": ["TODO", "IN_PROGRESS", "QA", "RESOLVED", "DONE"]
          },
          "time_allocations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TimeAllocation" }
          }
        },
        "required": [
          "id", "writer_id", "writer_name", "writer_status",
          "assignee_id", "assignee_name", "assignee_status",
          "title", "content", "start_date", "end_date", "status", "time_allocations"
        ]
      },
      "WbsRequest": {
        "type": "object",
        "description": "POST·PUT 공통 바디. 프론트는 항상 모든 필드를 채워 보낸다(부분 전송 없음)",
        "properties": {
          "assignee_id": { "type": "integer", "format": "int64" },
          "title": { "type": "string", "maxLength": 200 },
          "content": { "type": "string", "nullable": true },
          "start_date": { "type": "string", "format": "date" },
          "end_date": { "type": "string", "format": "date", "description": "start_date 이상이어야 함. 미만이면 400 VALIDATION_ERROR" },
          "status": {
            "type": "string",
            "enum": ["TODO", "IN_PROGRESS", "QA", "RESOLVED", "DONE"],
            "description": "POST에서는 무시되고 TODO로 저장된다. PUT에서만 반영되며, DONE 전이는 관리자만 가능(일반 회원이 DONE을 보내면 403)"
          },
          "time_allocations": {
            "type": "array",
            "description": "기존 시간 할당을 완전히 대체한다(전량 삭제 후 재삽입). 빈 배열을 보내면 해당 WBS의 시간 할당이 모두 삭제된다",
            "items": { "$ref": "#/components/schemas/TimeAllocation" }
          }
        },
        "required": [
          "assignee_id", "title", "content", "start_date", "end_date", "status", "time_allocations"
        ]
      },
      "DailySum": {
        "type": "object",
        "properties": {
          "work_date": { "type": "string", "format": "date" },
          "total_hours": { "type": "integer", "description": "해당 회원이 그 날짜에 담당한 모든 WBS의 저장된 시간 합계. 8을 넘을 수 있다" }
        },
        "required": ["work_date", "total_hours"]
      }
    },
    "responses": {
      "ValidationError": {
        "description": "VALIDATION_ERROR",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Unauthorized": {
        "description": "UNAUTHORIZED",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Forbidden": {
        "description": "FORBIDDEN",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFound": {
        "description": "NOT_FOUND",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    }
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/auth/signup": {
      "post": {
        "summary": "회원가입",
        "description": "인증 불필요. 가입 시 토큰을 발급하지 않으므로 이후 로그인 화면으로 이동한다",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email", "maxLength": 100 },
                  "password": { "type": "string", "maxLength": 255 },
                  "name": { "type": "string", "maxLength": 50 }
                },
                "required": ["email", "password", "name"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "회원가입 성공. 생성된 회원 정보를 반환하며 토큰은 포함하지 않는다",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR(이메일 형식 오류·필수값 누락) 또는 DUPLICATE_EMAIL(이메일 중복)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "로그인",
        "description": "인증 불필요. 자격 증명 불일치·탈퇴 계정(status='WITHDRAWN')은 모두 401 UNAUTHORIZED로 처리한다",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email", "maxLength": 100 },
                  "password": { "type": "string", "maxLength": 255 }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "로그인 성공. refresh_token은 httpOnly 쿠키로 전달된다",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "액세스 토큰 재발급",
        "description": "httpOnly refresh 쿠키만으로 재발급하며 Bearer 토큰을 요구하지 않는다(새로고침 직후 호출 가능). 쿠키 없음·만료·token_version 불일치는 401",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "재발급 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "로그아웃",
        "description": "본인만 호출 가능(토큰 소유자). token_version +1로 기존 refresh token을 무효화한다",
        "responses": {
          "200": { "description": "로그아웃 성공. 응답 바디 없음" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "내 정보 조회 (마이페이지)",
        "description": "본인만 조회 가능(토큰 소유자)",
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "delete": {
        "summary": "회원 탈퇴",
        "description": "본인만 탈퇴 가능(토큰 소유자). status='WITHDRAWN' 전환, token_version +1. 작성한 WBS는 유지된다",
        "responses": {
          "200": { "description": "탈퇴 성공. 응답 바디 없음" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/users": {
      "get": {
        "summary": "담당자 선택 목록 조회",
        "description": "로그인한 회원이면 누구나 조회 가능. 탈퇴 회원도 status='WITHDRAWN'으로 함께 반환되므로, 신규 담당자 지정 시 프론트에서 제외한다",
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/UserSummary" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/wbs": {
      "get": {
        "summary": "WBS 목록 조회 (캘린더 5주 뷰 또는 내 WBS관리 탭)",
        "description": "로그인한 회원이면 누구나 조회 가능. 파라미터 조합 규칙: (1) 캘린더 = from·to 필수, 기간이 겹치는 전체 회원의 WBS 반환. (2) 내 WBS관리 탭 = mine=true, 기간과 무관하게 본인 작성 WBS 반환하며 from·to는 무시된다. (3) status는 두 경우 모두 선택이며 생략하면 전체 상태 포함. (4) from·to·mine을 모두 생략하면 400 VALIDATION_ERROR",
        "parameters": [
          { "name": "from", "in": "query", "description": "mine 미지정 시 필수", "schema": { "type": "string", "format": "date" } },
          { "name": "to", "in": "query", "description": "mine 미지정 시 필수", "schema": { "type": "string", "format": "date" } },
          { "name": "mine", "in": "query", "description": "true면 본인 작성 WBS만, 기간 무시", "schema": { "type": "boolean" } },
          {
            "name": "status",
            "in": "query",
            "description": "생략 시 전체 상태",
            "schema": {
              "type": "string",
              "enum": ["TODO", "IN_PROGRESS", "QA", "RESOLVED", "DONE"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Wbs" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "summary": "WBS 등록",
        "description": "로그인한 회원이면 누구나 등록 가능하며 writer_id는 토큰의 회원으로 설정된다. 요청 바디의 status는 무시되고 항상 TODO로 저장되므로 등록 단계에서 상태 권한 검증(403)은 발생하지 않는다. end_date < start_date, 또는 work_date가 기간을 벗어나면 400",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WbsRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "등록 성공. 생성된 WBS 전체(작성자·담당자 이름 포함)를 반환",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Wbs" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/wbs/{id}": {
      "get": {
        "summary": "WBS 단건 조회 (상세패널)",
        "description": "로그인한 회원이면 누구나 조회 가능. time_allocations를 포함해 반환하므로 상세패널이 이 응답만으로 채워진다",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Wbs" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "summary": "WBS 수정 (전체 필드 치환, 상태 변경도 이 경로)",
        "description": "작성자 본인 또는 관리자만 수정 가능(그 외 403). DONE 전이는 관리자만 가능하며 일반 회원이 시도하면 403. time_allocations는 기존 레코드를 전량 삭제 후 재삽입하는 방식으로 완전히 대체되며, 빈 배열을 보내면 시간 할당이 모두 삭제된다. end_date < start_date, 또는 work_date가 기간을 벗어나면 400",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WbsRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "수정 성공. 수정된 WBS 전체를 반환",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Wbs" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "summary": "WBS 삭제",
        "description": "작성자 본인만 삭제 가능하며 관리자도 타인 글은 삭제할 수 없다(403). 삭제 시 하위 time_allocations도 함께 삭제된다(DB CASCADE)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }
        ],
        "responses": {
          "200": { "description": "삭제 성공. 응답 바디 없음" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/time-allocations/daily-sum": {
      "get": {
        "summary": "일자별 시간 합계 조회 (8시간 초과 경고용, assignee_id 기준)",
        "description": "로그인 필요. 담당자 지정을 위해 타인 user_id 조회도 허용한다. 합계는 해당 회원이 담당한 **모든 WBS의 저장된 시간**이며, 지금 편집 중인 WBS의 기존 저장분도 포함된다. 따라서 상세패널에서 경고를 계산할 때는 `total_hours - 이 WBS의 기존 저장값 + 현재 미저장 입력값 > 8` 로 판정한다",
        "parameters": [
          { "name": "user_id", "in": "query", "required": true, "description": "합계를 구할 담당자(assignee_id)", "schema": { "type": "integer", "format": "int64" } },
          { "name": "from", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } },
          { "name": "to", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } }
        ],
        "responses": {
          "200": {
            "description": "조회 성공. 시간 할당이 없는 날짜는 배열에 포함되지 않는다",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/DailySum" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    }
  }
}
