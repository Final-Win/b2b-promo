# 운영(production) 환경변수 템플릿. 실제 값을 채운 .env.production은
# 커밋하지 않는다(.gitignore 등록됨). NODE_ENV=production으로 실행하면
# server.js가 .env 대신 이 파일을 읽는다.
#
# 주의: refresh 쿠키가 Secure 플래그로 발급된다(auth.controller.js).
# 즉 이 서버는 반드시 HTTPS 뒤에서 서비스해야 한다 — HTTP로만 운영하면
# 브라우저가 쿠키를 저장/전송하지 않아 로그인 후 새로고침 시 로그아웃된다.
NODE_ENV=production
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PORT=3000
CORS_ORIGIN=https://<운영 프론트 도메인>
